# Copiá este archivo a .env y ajustá los valores. .env está gitignored.
#   cp .env.example .env

# --- Puertos del honeypot (lo que ve el mundo) ---
# En producción poné 80 y 443. En local, algo que no choque (ej. 9080/9443).
HTTP_PORT=9080
HTTPS_PORT=9443

# CN del certificado TLS autofirmado que se genera al primer arranque
TLS_CN=localhost

# Máximo de body que se guarda por request, en bytes (default 256 KiB)
CAPTURE_MAX_BODY=262144

# --- Base de datos ---
# CAMBIÁ DB_PASS en cualquier despliegue real. Esto es un default de desarrollo.
DB_NAME=honeypot
DB_USER=honeypot
DB_PASS=change-me

# Puertos SOLO-loopback para administración (no se exponen a internet):
DB_HOST_PORT=5433      # Postgres accesible en 127.0.0.1:5433 (psql / túnel SSH)
DASHBOARD_PORT=8088    # dashboard en 127.0.0.1:8088 (túnel SSH)

# --- Alertas (servicio alerter) ---
# Webhook opcional para alertas. Vacío = solo se guardan en la tabla alerts (visibles
# en el dashboard). Un webhook de Slack o Discord funciona tal cual (manda {text/content}).
ALERT_WEBHOOK_URL=
# Severidad mínima que dispara el webhook: info|low|medium|high|critical
ALERT_MIN_SEVERITY=high
# Cada cuántos segundos el watcher busca requests nuevos
ALERT_POLL_INTERVAL=5
